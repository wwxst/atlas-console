# Copy to /opt/atlas/.env on the production host, chmod 600, never commit secrets.
# ATLAS_DB_MODE=docker uses the private PostgreSQL Compose overlay; external uses an existing Baota/managed PostgreSQL.
ATLAS_DB_MODE=docker
# Each same-host installation needs a distinct directory, project, subnet and port.
ATLAS_PROJECT_NAME=atlas
ATLAS_NETWORK_PREFIX=172.30.80
ATLAS_RELEASE_DIR=/opt/atlas/releases
# Compose dotenv syntax, NOT a shell script. Do not source this file.
# The installer safely serializes $, #, spaces, quotes and backslashes.
ATLAS_DB_URL=jdbc:postgresql://postgres:5432/web_project
ATLAS_DB_USERNAME=atlas
# For Docker mode this is the PostgreSQL container password. For external mode set it to the existing PostgreSQL user's password.
ATLAS_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Generate JWT secret with: openssl rand -base64 48
DB_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_VALUE
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_RANDOM_SECRET
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_VALID_STORAGE_KEY
# Leave false for fresh installs. Only set true once to baseline a backed-up,
# schema-verified legacy database that has no flyway_schema_history.
ATLAS_FLYWAY_BASELINE_ON_MIGRATE=false
ATLAS_HTTP_PORT=8088

# Leave disabled until the server, runner, and GitHub fine-grained PAT are ready.
ATLAS_DEPLOYMENT_ENABLED=false
ATLAS_DEPLOYMENT_GITHUB_TOKEN=
